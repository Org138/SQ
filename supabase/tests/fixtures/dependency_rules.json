{
  "about": "Dependency gating cases checked by both the app (test/dependency_rules_test.dart) and the database (supabase/tests/database/dependency_rules.test.sql, generated by tool/generate_dependency_rules.dart). A link [\"A\", \"B\"] means A depends on B. Steps run in order; every step before the last must be allowed, and expect is the outcome of the last one.",
  "cases": [
    {
      "name": "a task can't start while a dependency isn't done",
      "tasks": {"A": "todo", "B": "todo"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "A", "to": "in_progress"}],
      "expect": "deny"
    },
    {
      "name": "a task can't be finished while a dependency isn't done",
      "tasks": {"A": "todo", "B": "in_progress"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "A", "to": "done"}],
      "expect": "deny"
    },
    {
      "name": "a task can't start while any one dependency isn't done",
      "tasks": {"A": "todo", "B": "done", "C": "todo"},
      "links": [["A", "B"], ["A", "C"]],
      "steps": [{"action": "set_status", "task": "A", "to": "in_progress"}],
      "expect": "deny"
    },
    {
      "name": "a task can start once every dependency is done",
      "tasks": {"A": "todo", "B": "done", "C": "done"},
      "links": [["A", "B"], ["A", "C"]],
      "steps": [{"action": "set_status", "task": "A", "to": "in_progress"}],
      "expect": "allow"
    },
    {
      "name": "a task with no dependencies can be finished",
      "tasks": {"A": "todo"},
      "links": [],
      "steps": [{"action": "set_status", "task": "A", "to": "done"}],
      "expect": "allow"
    },
    {
      "name": "a blocked task can stay todo",
      "tasks": {"A": "todo", "B": "todo"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "A", "to": "todo"}],
      "expect": "allow"
    },
    {
      "name": "a started task can move back to todo",
      "tasks": {"A": "in_progress", "B": "done"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "A", "to": "todo"}],
      "expect": "allow"
    },
    {
      "name": "a done task can't be reopened while a dependent has started",
      "tasks": {"A": "in_progress", "B": "done"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "B", "to": "todo"}],
      "expect": "deny"
    },
    {
      "name": "a done task can't move back to in progress while a dependent is done",
      "tasks": {"A": "done", "B": "done"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "B", "to": "in_progress"}],
      "expect": "deny"
    },
    {
      "name": "a done task can be reopened while its dependents are todo",
      "tasks": {"A": "todo", "B": "done"},
      "links": [["A", "B"]],
      "steps": [{"action": "set_status", "task": "B", "to": "todo"}],
      "expect": "allow"
    },
    {
      "name": "a task can't depend on itself",
      "tasks": {"A": "todo"},
      "links": [],
      "steps": [{"action": "add_link", "task": "A", "depends_on": "A"}],
      "expect": "deny"
    },
    {
      "name": "two tasks can't depend on each other",
      "tasks": {"A": "todo", "B": "todo"},
      "links": [["A", "B"]],
      "steps": [{"action": "add_link", "task": "B", "depends_on": "A"}],
      "expect": "deny"
    },
    {
      "name": "a longer chain can't loop back",
      "tasks": {"A": "todo", "B": "todo", "C": "todo"},
      "links": [["A", "B"], ["B", "C"]],
      "steps": [{"action": "add_link", "task": "C", "depends_on": "A"}],
      "expect": "deny"
    },
    {
      "name": "a shortcut along a chain is not a cycle",
      "tasks": {"A": "todo", "B": "todo", "C": "todo"},
      "links": [["A", "B"], ["B", "C"]],
      "steps": [{"action": "add_link", "task": "A", "depends_on": "C"}],
      "expect": "allow"
    },
    {
      "name": "a todo task can gain an unfinished dependency",
      "tasks": {"A": "todo", "B": "in_progress"},
      "links": [],
      "steps": [{"action": "add_link", "task": "A", "depends_on": "B"}],
      "expect": "allow"
    },
    {
      "name": "a started task can't gain an unfinished dependency",
      "tasks": {"A": "in_progress", "B": "todo"},
      "links": [],
      "steps": [{"action": "add_link", "task": "A", "depends_on": "B"}],
      "expect": "deny"
    },
    {
      "name": "a done task can't gain an unfinished dependency",
      "tasks": {"A": "done", "B": "in_progress"},
      "links": [],
      "steps": [{"action": "add_link", "task": "A", "depends_on": "B"}],
      "expect": "deny"
    },
    {
      "name": "a started task can gain a finished dependency",
      "tasks": {"A": "in_progress", "B": "done"},
      "links": [],
      "steps": [{"action": "add_link", "task": "A", "depends_on": "B"}],
      "expect": "allow"
    },
    {
      "name": "deleting an unfinished blocker lets its dependents start",
      "tasks": {"A": "todo", "B": "todo"},
      "links": [["A", "B"]],
      "steps": [
        {"action": "delete_task", "task": "B"},
        {"action": "set_status", "task": "A", "to": "in_progress"}
      ],
      "expect": "allow"
    },
    {
      "name": "removing a dependency link unblocks the task",
      "tasks": {"A": "todo", "B": "todo"},
      "links": [["A", "B"]],
      "steps": [
        {"action": "remove_link", "task": "A", "depends_on": "B"},
        {"action": "set_status", "task": "A", "to": "in_progress"}
      ],
      "expect": "allow"
    },
    {
      "name": "finishing the blocker unblocks the task",
      "tasks": {"A": "todo", "B": "in_progress"},
      "links": [["A", "B"]],
      "steps": [
        {"action": "set_status", "task": "B", "to": "done"},
        {"action": "set_status", "task": "A", "to": "in_progress"}
      ],
      "expect": "allow"
    },
    {
      "name": "a link added after starting still blocks reopening the dependency",
      "tasks": {"A": "in_progress", "B": "done"},
      "links": [],
      "steps": [
        {"action": "add_link", "task": "A", "depends_on": "B"},
        {"action": "set_status", "task": "B", "to": "todo"}
      ],
      "expect": "deny"
    }
  ]
}
